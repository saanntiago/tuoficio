rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*');
    }

    // HU-07: imágenes hasta 5 MB y video del portafolio hasta 50 MB.
    function isValidSize() {
      return (request.resource.contentType.matches('image/.*') && request.resource.size <= 5 * 1024 * 1024) ||
             (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024);
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId) && isImageOrVideo() && isValidSize();
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageOrVideo() && isValidSize();
    }
  }
}
