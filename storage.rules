rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*');
    }

    // HU-07: imágenes hasta 5 MB y video del portafolio hasta 50 MB.
    function isValidSize() {
      return (request.resource.contentType.matches('image/.*') && request.resource.size <= 5 * 1024 * 1024) ||
             (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024);
    }

    // Avatar y portafolio: lectura pública para que se vean en el directorio.
    match /users/{userId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageOrVideo() && isValidSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Documento de identidad y selfie: solo el dueño o un administrador.
    match /users/{userId}/private/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImageOrVideo() && isValidSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageOrVideo() && isValidSize();
    }
  }
}
